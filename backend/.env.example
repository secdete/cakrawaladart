# Copy the full Session pooler URI from Supabase > Connect. Do not guess the host.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# Change these before the first app startup against a new shared database.
ADMIN_LOGIN_EMAIL=admin@cakrawalaeducentre.com
ADMIN_LOGIN_PASSWORD=replace-this-with-a-long-unique-password

# Use the deployed website origin in production. Local development can use *.
CORS_ORIGINS=*
PORT=8000
HOST=0.0.0.0
